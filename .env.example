# VerbaCore Environment Configuration Example
# Copy to `.env` (gitignored) and customize as needed.
# All variables are optional; portable OS defaults are used when unset.

# --- Server ---
# Host address to bind the FastAPI server (keep 127.0.0.1 for local-only use)
VERBACORE_HOST=127.0.0.1
# Listening port for the web UI and API
VERBACORE_PORT=7860

# --- Storage Paths ---
# Root directory for recordings, reports, uploads, and cloud_config.json
# Default: %LOCALAPPDATA%\verbacore (Windows) | ~/Library/Application Support/verbacore (macOS) | ~/.local/share/verbacore (Linux)
# VERBACORE_DATA_DIR=
# Model weights cache directory (faster-whisper + GGUF models)
# Default: <VERBACORE_DATA_DIR>/models
# VERBACORE_MODELS_DIR=

# --- Local Brain LLM (Diarization & Executive Summary) ---
# Base URL for Ollama or llama-server OpenAI-compatible API
VERBACORE_LLM_URL=http://127.0.0.1:11434
# Optional custom path to llama-server binary (auto-discovered if unset)
# VERBACORE_LLAMA_SERVER=
# Optional custom path to local GGUF model file (auto-discovered in models dir if unset)
# VERBACORE_GGUF_MODEL=

# --- Optional Cloud Fallback API Keys ---
# Cloud transcription is 100% optional and off by default.
# Keys set here override values stored in cloud_config.json.
GEMINI_API_KEY=
GROQ_API_KEY=
